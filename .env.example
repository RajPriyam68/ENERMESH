# EnerMesh environment template — provider-agnostic.
# Copy to .env (never commit secrets). Core app runs without AI keys.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Express trust proxy. "false" when the API is directly reachable.
# Set to the number of proxy hops (e.g. 1) only when deployed behind a trusted proxy.
TRUST_PROXY=false

# --- Database (PostgreSQL: local / Docker / Supabase / Neon / RDS) ---
DATABASE_URL=postgresql://enermesh:enermesh@localhost:5432/enermesh?schema=public

# --- Auth (set strong values in every environment) ---
JWT_ACCESS_SECRET=replace-with-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Blockchain (Polygon Amoy by default; any EVM network via these vars) ---
CHAIN_ID=80002
CHAIN_NAME=polygon-amoy
RPC_URL=https://rpc-amoy.polygon.technology
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
CONTRACT_ADDRESS=
# Server-side reads only. Never put private keys here or in the frontend.

# --- Realtime ---
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME=polygon-amoy
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_CONTRACT_ADDRESS=

# --- AI (optional; core marketplace works without these) ---
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=
USER_LLM_PROVIDER=

# --- IoT (optional) ---
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
