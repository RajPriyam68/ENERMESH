# EnerMesh environment template — provider-agnostic.
# Copy to .env (never commit secrets). Core app runs without AI keys.
# Development: NODE_ENV=development. Tests: NODE_ENV=test (set by the test runner).
# Production: NODE_ENV=production and unique JWT secrets of at least 32 characters.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Express trust proxy. "false" when the API is directly reachable.
# Set to the number of proxy hops (e.g. 1) only when deployed behind a trusted proxy.
TRUST_PROXY=false
# Docker API entrypoint runs Prisma migrate deploy unless set to false.
RUN_MIGRATIONS=true

# --- Database (PostgreSQL: local / Docker / Supabase / Neon / RDS) ---
DATABASE_URL=postgresql://enermesh:enermesh@localhost:5432/enermesh?schema=public
POSTGRES_USER=enermesh
POSTGRES_PASSWORD=enermesh
POSTGRES_DB=enermesh
POSTGRES_PORT=5432

# --- Auth (set strong unique values in every non-local environment) ---
JWT_ACCESS_SECRET=replace-with-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Blockchain (Polygon Amoy by default; any EVM network via these vars) ---
CHAIN_ID=80002
CHAIN_NAME=polygon-amoy
RPC_URL=https://rpc-amoy.polygon.technology
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
CONTRACT_ADDRESS=
# Server-side reads only. Never put private keys here or in the frontend.
# Optional local deploy only — never commit this value:
# DEPLOYER_PRIVATE_KEY=

# --- Realtime ---
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Empty uses the current origin (Next rewrite /socket.io -> API). Set an absolute
# Socket.IO URL only when the browser talks to the API on a different origin.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME=polygon-amoy
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Server-side rewrite target used by Next.js. Docker Compose sets http://api:3001.
API_INTERNAL_URL=http://localhost:3001

# --- AI (optional; core marketplace works without these) ---
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=
USER_LLM_PROVIDER=

# --- IoT (optional) ---
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Password reset ---
# Token lifetime in minutes (default 60). Valid range 5–1440.
PASSWORD_RESET_TTL_MINUTES=60
# Public web origin used in reset emails. Falls back to WEB_ORIGIN.
PASSWORD_RESET_APP_URL=http://localhost:3000
# SMTP connection URL. Provider-agnostic. Required in production.
# Mailpit is development-only (compose profile `dev`). Do not use it in production.
#
# API on the host (Windows / macOS / Linux, ./start.sh):
#   SMTP_URL=smtp://localhost:1025
# API inside Docker Compose (same project as Mailpit, --profile dev):
#   SMTP_URL=smtp://mailpit:1025
# Never use localhost:1025 from inside the API container.
#
# Production examples (any SMTP/SMTPS provider):
#   smtp://USER:PASSWORD@smtp.example.com:587
#   smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=smtp://localhost:1025
SMTP_FROM=EnerMesh <noreply@localhost>

# --- Admin bootstrap (never commit real values; never self-assign via /register) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=EnerMesh Admin
